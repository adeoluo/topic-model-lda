flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        CLI["CLI<br/>topics, evaluate, serve"]:::edge
        Client(["HTTP client"]):::edge
        Router["HTTP router<br/>/topics /infer"]:::core
        Validate["Validation<br/>non-empty text, cap"]:::control
        CLI ~~~ Client --> Router --> Validate
    end

    subgraph Data["Corpus and config"]
        direction TB
        Docs[("60 documents<br/>3 latent themes")]:::data
        Tokenize["Tokenizer<br/>stopwords removed"]:::core
        Config["LDA config<br/>K, alpha, beta"]:::control
        Docs --> Tokenize ~~~ Config
    end

    subgraph Train["Collapsed Gibbs sampling"]
        direction TB
        Init["Random init<br/>one topic per token"]:::core
        Counts[("Count tables<br/>n_dk, n_kw, n_k")]:::data
        Gibbs["Gibbs sweep<br/>full conditional"]:::core
        Init --> Counts --> Gibbs
    end

    subgraph Obs["Queries and evaluation"]
        direction TB
        Topics["Topic top words<br/>highest n_kw"]:::core
        Infer["Document inference<br/>log-sum-exp scores"]:::core
        Coherence["UMass coherence<br/>per topic, mean"]:::obs
        Metrics["Route metrics<br/>Prometheus text"]:::obs
        Topics --> Coherence
        Infer ~~~ Metrics
    end

    Interfaces -->|train at startup| Train
    Data -->|indexed corpus| Train
    Train -->|count tables| Obs
